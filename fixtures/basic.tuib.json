{
  "schemaVersion": 1,
  "name": "Generated Smoke Test",
  "frames": [
    {
      "id": "screen-one",
      "name": "Dashboard",
      "x": 0,
      "y": 0,
      "columns": 80,
      "rows": 24,
      "root": {
        "type": "layout",
        "id": "root",
        "name": "Root",
        "direction": "vertical",
        "margin": 1,
        "spacing": 1,
        "flex": "legacy",
        "children": [
          {
            "constraint": { "kind": "length", "value": 3 },
            "node": {
              "type": "widget",
              "id": "title",
              "name": "Title",
              "widget": { "kind": "paragraph", "text": "Generated by TUI Builder", "alignment": "center", "wrap": true },
              "style": { "foreground": { "kind": "named", "value": "lightCyan" }, "bold": true },
              "block": { "title": "APP", "borders": "all", "borderType": "rounded", "padding": [0, 1, 0, 1], "style": {}, "shadow": false }
            }
          },
          {
            "constraint": { "kind": "fill", "value": 1 },
            "node": {
              "type": "widget",
              "id": "table",
              "name": "Services",
              "widget": { "kind": "table", "headers": ["Service", "Status"], "rows": [["api", "healthy"], ["worker", "healthy"]], "widths": [{ "kind": "fill", "value": 1 }, { "kind": "fill", "value": 1 }], "selected": 0 },
              "style": { "foreground": { "kind": "named", "value": "white" } },
              "block": { "title": "SERVICES", "borders": "all", "borderType": "rounded", "padding": [0, 1, 0, 1], "style": {}, "shadow": false }
            }
          }
        ]
      },
      "overlays": []
    }
  ]
}
